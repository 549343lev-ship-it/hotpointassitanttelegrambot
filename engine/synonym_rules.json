{
  "_comment": "Правила канонізації універсальних назв. Формат: {категорія: {rules:[{when,unless,drop,map}], family:[{match,label}]}}. Редагується без зміни коду; після правки — кнопка 'Схожі: правила'.",
  "_common": {
    "rules": [
      {
        "_note": "розділювач розмірів: 500*1000 → 500х1000",
        "map": {
          "(\\d)\\s*\\*\\s*(\\d)": "\\1х\\2"
        }
      },
      {
        "_note": "службові позначки постачання",
        "drop": [
          "\\(\\s*(п/з|под\\s*заказ|під\\s*замовлення|знято\\s*з\\s*виробництва|вчп|штамп|зразок|упаковка|акція)\\s*\\)",
          "(?<![а-яa-z])(п/з|под\\s*заказ|знято\\s*з\\s*виробництва)(?![а-яa-z])"
        ]
      },
      {
        "_note": "артикул у дужках та марки сплаву",
        "drop": [
          "\\(\\s*[a-z0-9\\-\\.]{4,}\\s*\\)",
          "(?<![а-яa-z])(cw617n|cw602n|cw614n)(?![а-яa-z])",
          "(?<![а-яa-z])ral\\s*\\d{4}(?![а-яa-z])"
        ]
      },
      {
        "_note": "голий числовий артикул (6553001) — у дужках або в кінці назви",
        "drop": [
          "\\(\\s*\\d{5,}\\s*\\)",
          "(?<![а-яa-z\\d/\\.\\-х])\\d{6,}(?![\\d/\\.\\-х])"
        ]
      }
    ]
  },
  "sewage": {
    "rules": [
      {
        "_note": "Колір дублює систему: внутрішня=сіра, безшумна=біла, зовнішня=помаранчева/зелена. Прибираємо лише коли система названа явно.",
        "when": "(?<![а-я])вн(?![а-я])|зовн|безшум",
        "drop": [
          "(?<![а-я])(сіра|сіре|сірий|біла|біле|білий|помаранчева|помаранчевий|зелена|зелений|чорна|чорний)(?![а-я])"
        ]
      },
      {
        "_note": "Товщина стінки в межах системи однакова у всіх брендів (перевірено по каталогу).",
        "when": "(?<![а-я])вн(?![а-я])|зовн|безшум",
        "drop": [
          "х\\s*\\d+\\.\\d+(?=\\s|$)"
        ]
      }
    ],
    "family": [
      {
        "match": "безшум",
        "label": "каналізація безшумна"
      },
      {
        "match": "зовн",
        "label": "каналізація зовнішня"
      },
      {
        "match": "(?<![а-я])вн(?![а-я])",
        "label": "каналізація внутрішня"
      }
    ]
  },
  "shutoff_valves": {
    "rules": [
      {
        "_note": "PN у аналогів різний — паспортні дані кожного виробника свої.",
        "drop": [
          "(?<![а-яa-z])pn\\s*\\d+(?![а-яa-z0-9])"
        ]
      },
      {
        "_note": "артикули виробника (DRB1, GRDV011, PSV01, CBH-01); DN/PN/SN виключені",
        "drop": [
          "(?<![а-яa-z0-9/\\-])(?!dn|pn|ral|sn|ду|ру)[a-z]{2,6}-?\\d{1,3}[a-z]?(?![а-яa-z0-9/])"
        ]
      }
    ],
    "family": [
      {
        "match": "кульов",
        "label": "кран кульовий"
      },
      {
        "match": "зворотн|обратн",
        "label": "клапан зворотний"
      },
      {
        "match": "фільтр",
        "label": "фільтр механічний"
      },
      {
        "match": "батерфляй|засувк|затвор",
        "label": "засувка"
      },
      {
        "match": "вентиль",
        "label": "вентиль"
      }
    ]
  },
  "adapters_reducers": {
    "rules": [
      {
        "drop": [
          "(?<![а-яa-z])pn\\s*\\d+(?![а-яa-z0-9])"
        ]
      }
    ],
    "family": [
      {
        "match": "press|(прес).{0,14}(інокс|inox|нержав)|(інокс|inox|нержав).{0,14}(прес)",
        "label": "прес нержавійка"
      },
      {
        "match": "(мідн|мідь|copper)",
        "label": "прес мідь"
      },
      {
        "match": "ніпел",
        "label": "ніпель"
      },
      {
        "match": "футорк",
        "label": "футорка"
      },
      {
        "match": "американк|розбірне",
        "label": "американка"
      },
      {
        "match": "подовжувач",
        "label": "подовжувач"
      },
      {
        "match": "кут|коліно",
        "label": "кут латунний"
      },
      {
        "match": "трійник",
        "label": "трійник латунний"
      }
    ]
  },
  "plastic_ppr": {
    "_note": "PN і серію НЕ прибираємо: перевірено — схлопування дає 63% конфліктів усередині бренду (Ekoplastik має EVO і Fiber Basalt одночасно).",
    "rules": [
      {
        "_note": "Серії армування — різні бренди мають свої назви для одного типу",
        "when": "труба",
        "drop": [
          "(?<![а-яa-z])(hot|cold|nano\\s*ag\\s*composite|pp-rct|faser|fiber|basalt|stabi|evo|al-rct|al\\s*rct)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Товщина стінки у різних виробників різна для однакового діаметру і PN",
        "when": "труба",
        "drop": [
          "х\\s*\\d+[.,]\\d+\\s*мм(?=\\s*,|\\s*$|\\s*\\{)"
        ]
      }
    ],
    "family": [
      {
        "match": "fiber|faser|basalt|glass|stabi|композит|армов",
        "label": "труба опалення"
      },
      {
        "match": "труба.*pn\\s*25|pn\\s*25.*труба",
        "label": "труба опалення"
      },
      {
        "match": "труба.*(?<![а-яa-z])evo(?![а-яa-zh])",
        "label": "труба водопровідна"
      },
      {
        "match": "труба.*pn\\s*(10|16|20)(?!\\d)",
        "label": "труба водопровідна"
      },
      {
        "match": "^труба|(?<![а-я])труба(?![а-я])",
        "label": "труба PPR"
      },
      {
        "match": "муфта",
        "label": "муфта PPR"
      },
      {
        "match": "коліно|відвід",
        "label": "коліно PPR"
      },
      {
        "match": "трійник",
        "label": "трійник PPR"
      },
      {
        "match": "кран|вентиль",
        "label": "кран PPR"
      },
      {
        "match": "заглушка",
        "label": "заглушка PPR"
      },
      {
        "match": "опора|планка|хомут",
        "label": "кріплення PPR"
      }
    ]
  },
  "push_systems": {
    "rules": [
      {
        "drop": [
          "(?<![а-яa-z])evoh(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "труба",
        "label": "труба PUSH"
      },
      {
        "match": "гільз|кільц",
        "label": "гільза PUSH"
      },
      {
        "match": "євроконус",
        "label": "євроконус"
      },
      {
        "match": "муфта|коліно|трійник|фітинг",
        "label": "фітинг PUSH"
      }
    ]
  },
  "insulation": {
    "rules": [
      {
        "_note": "«ламін.» є не в усіх брендів, «для труб» — службове",
        "drop": [
          "(?<![а-я])ламін(?![а-я])",
          "для\\s+труб"
        ]
      }
    ],
    "family": [
      {
        "match": "утеплювач|ізоляц|мірелон|flex",
        "label": "утеплювач труб"
      }
    ]
  },
  "radiators_radiatorsvalve": {
    "rules": [
      {
        "_note": "маркетингові суб-лінійки одного типу радіатора",
        "drop": [
          "(?<![а-яa-z])(graphite|plan|ventil|compact|plv|profil|hygiene|klasik)(?![а-яa-z])",
          "\\(\\s*(лижі|настінне\\s*кріплення)\\s*\\)"
        ]
      },
      {
        "_note": "Тип підключення — всі бренди мають і бокове і нижнє, не впливає на вибір аналогу",
        "drop": [
          ",\\s*(?<![а-яa-z])[kvch](?![а-яa-z0-9]),",
          "(?<![а-яa-z])(бокове|нижнє|нижн|бічн)\\.?\\s*підключ[а-я]*"
        ]
      }
    ],
    "family": [
      {
        "match": "термоголовк|термостат",
        "label": "термоголовка"
      },
      {
        "match": "біметал",
        "label": "радіатор біметалевий"
      },
      {
        "match": "алюмін",
        "label": "радіатор алюмінієвий"
      },
      {
        "match": "тип\\s*1[01]",
        "label": "радіатор тип 11"
      },
      {
        "match": "тип\\s*2[12]",
        "label": "радіатор тип 22"
      },
      {
        "match": "тип\\s*3[03]",
        "label": "радіатор тип 33"
      },
      {
        "match": "радіатор",
        "label": "радіатор сталевий"
      }
    ]
  },
  "metal_plastic": {
    "rules": [
      {
        "_note": "Артикули в назвах (109500 HLV NEW) — виробничі коди",
        "drop": [
          "^\\d{5,}\\s+",
          "(?<![а-яa-z])(new|plus)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Кут нахилу колектора і комплектація",
        "when": "колектор",
        "drop": [
          "\\d+°",
          "(?<![а-яa-z])(без\\s*євроконуса?|з\\s*євроконусом|без\\s*євроконуса?)(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "труба",
        "label": "труба металопластик"
      },
      {
        "match": "прес|муфта|коліно|трійник|фітинг",
        "label": "прес-фітинг металопластик"
      }
    ]
  },
  "underfloor_heating": {
    "rules": [
      {
        "_note": "Серії колекторів (Brass Line, Steel Line) — матеріал вже є в назві (латунь/сталь)",
        "drop": [
          "(?<![а-яa-z])(brass\\s*line|steel\\s*line|brass|stainless)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Комплектація колектора — євроконус є в кожного виробника",
        "when": "колектор",
        "drop": [
          "(?<![а-яa-z])(єврокон\\.?|без\\s*євроконуса?|з\\s*євроконусом)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Пошкоджена упаковка — службова позначка",
        "drop": [
          "[-–]?\\s*пошкоджен[а-я]*\\.?\\s*(коробк[а-я]*|упаковк[а-я]*)?"
        ]
      }
    ],
    "family": [
      {
        "match": "колектор|гребінк",
        "label": "колектор теплої підлоги"
      },
      {
        "match": "стрічк|демпфер",
        "label": "демпферна стрічка"
      },
      {
        "match": "плівк",
        "label": "плівка з розміткою"
      },
      {
        "match": "скоб|такер|кліпс",
        "label": "кріплення теплої підлоги"
      },
      {
        "match": "терморегул",
        "label": "терморегулятор"
      },
      {
        "match": "шаф",
        "label": "шафа колекторна"
      }
    ]
  },
  "fasteners_sealants": {
    "rules": [
      {
        "_note": "Назви серій Walraven (BIS, BISMAT, BISUPPORT) — маркетингові",
        "when": "walraven|bis",
        "drop": [
          "(?<![а-яa-z])(bismat|bisupport|bis\\s*rapidrail|rapidrail|bis\\s*\\(nl\\)|2000)(?![а-яa-z0-9])"
        ]
      },
      {
        "_note": "Колір заглушок монтажних — несуттєво",
        "when": "заглушка монтажна",
        "drop": [
          "\\(\\s*(червона|синя|жовта|зелена)\\s*\\)"
        ]
      }
    ],
    "family": [
      {
        "match": "хомут",
        "label": "хомут кріплення"
      },
      {
        "match": "льон|пакля|unigarn",
        "label": "льон сантехнічний"
      },
      {
        "match": "герметик|силікон",
        "label": "герметик"
      },
      {
        "match": "паста|уніпак",
        "label": "паста ущільнювальна"
      },
      {
        "match": "мастило|glidex",
        "label": "мастило монтажне"
      },
      {
        "match": "фум|тефлон",
        "label": "ФУМ-стрічка"
      },
      {
        "match": "дюбель|шпильк|анкер",
        "label": "кріплення"
      }
    ]
  },
  "filtration": {
    "rules": [
      {
        "_note": "Серії фільтрів (DP 10 Mono/DUO, SENIOR PLUS) — маркетингові назви",
        "drop": [
          "(?<![а-яa-z])(dp\\s*10|senior\\s*plus|mono|duo|trio|junior|atlas|afo|bfo|sx|ts|kit)(?![а-яa-z0-9])",
          "(?<![а-яa-z0-9])[a-z]{2,3}\\d{3,}[a-z0-9]*(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "картридж",
        "label": "картридж фільтра"
      },
      {
        "match": "колб",
        "label": "колба фільтра"
      },
      {
        "match": "самопромивн|самоочисн",
        "label": "фільтр самопромивний"
      },
      {
        "match": "осмос",
        "label": "система осмосу"
      },
      {
        "match": "фільтр",
        "label": "фільтр води"
      }
    ]
  },
  "pumps": {
    "rules": [
      {
        "_note": "Артикульні коди насосів (SKD-1, PC-10, CPM 158) — це модель, НЕ прибираємо. Але серії типу Brio 2000-М прибираємо.",
        "when": "реле|автоматик",
        "drop": [
          "(?<![а-яa-z])(brio\\s*2000-?[mмт]?|brio\\s*2000mt|cristal)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Пошкоджена упаковка — службова позначка",
        "drop": [
          "[-–]\\s*пошкодж[а-я]*\\.?\\s*уп\\.?"
        ]
      }
    ],
    "family": [
      {
        "match": "циркуляц",
        "label": "насос циркуляційний"
      },
      {
        "match": "станц",
        "label": "насосна станція"
      },
      {
        "match": "гідроакумул|бак",
        "label": "гідроакумулятор"
      },
      {
        "match": "дренажн|фекальн",
        "label": "насос дренажний"
      },
      {
        "match": "свердловин|глибин",
        "label": "насос свердловинний"
      },
      {
        "match": "насос",
        "label": "насос"
      }
    ]
  },
  "heating": {
    "rules": [
      {
        "_note": "Артикульні коди на початку назви (8512, SLP1DF02N1D13, ВЗ001-К)",
        "drop": [
          "^[a-zа-яA-ZА-Я0-9]{3,12}\\s+(?=[А-ЯA-Z])",
          "^\\d{4,}\\s+"
        ]
      },
      {
        "_note": "Серії автоматики котелень (LIGHT, PROFI PLUS)",
        "when": "автоматик|контролер|контроллер",
        "drop": [
          "(?<![а-яa-z])(light|profi\\s*plus|profi|basic|wifi\\s*rs|i-1m|i-2|i-3|plus|st-i)(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "колектор",
        "label": "колектор опалення"
      },
      {
        "match": "клапан|вентиль",
        "label": "клапан термостатичний"
      },
      {
        "match": "насосн.?груп",
        "label": "насосна група"
      }
    ]
  },
  "siphons_fittings": {
    "rules": [
      {
        "_note": "Артикули AlcaPlast (A160-1/2, SA2000SK) — виробничі коди, не характеристика",
        "drop": [
          "(?<![а-яa-z]),?\\s*[a-z]{1,3}\\d{2,4}[a-z0-9\\-\\/]*(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "сифон",
        "label": "сифон"
      },
      {
        "match": "трап",
        "label": "трап"
      },
      {
        "match": "арматур|заповнюв|впускн|зливн",
        "label": "арматура зливна"
      },
      {
        "match": "гофр",
        "label": "гофра"
      }
    ]
  },
  "hoses": {
    "rules": [
      {
        "_note": "Тип оплетення — нерж/хром/поліам залишаємо (різні товари). Але довжина в кроках 0.2/0.3/0.4... — кожна довжина окремий товар, так і повинно бути.",
        "drop": [
          "(?<![а-яa-z])(нерж\\.?|ss|flex)(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "підводк|підведен",
        "label": "підводка гнучка"
      },
      {
        "match": "шланг",
        "label": "шланг"
      }
    ]
  },
  "boilers": {
    "rules": [
      {
        "_note": "Серії котлів — маркетингові назви, не характеристика. Бренд прибирається через _detect_brand.",
        "when": "котел",
        "drop": [
          "(?<![а-яa-z])(force|стандарт|турбо|універсал|mega|max|rinnova|cond|adaptive|light|vitodens|vitoladens|victrix|zeus|luna3?|mynute|extra|quattro|platinum|electronic|duo|trio|pellet|джавелін|автомат|plus|new)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Тип роботи котла — не потрібен в ключі бо є у назві типу",
        "when": "котел",
        "drop": [
          "(?<![а-яa-z])(конденсацій|парапет|підлогов|настінн|атмосфер|турбован)(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "газов",
        "label": "котел газовий"
      },
      {
        "match": "електр",
        "label": "котел електричний"
      },
      {
        "match": "твердопалив",
        "label": "котел твердопаливний"
      }
    ]
  },
  "water_heaters": {
    "rules": [
      {
        "_note": "Назви серій бойлерів — кожен виробник має свої. Залишаємо тільки об'єм і тип.",
        "when": "водонагрів|бойлер",
        "drop": [
          "(?<![а-яa-z])(lydos|velis|pro1|superlux|tronic|round|steatite|elite|genius|cube|classic|prime|vertigo|o'pro|opro|supr|tgrk|ego|pro|r\\s|nts|tech|esp|esd|tr\\d{4}|bcse|lydos|aquabravo|aqualtis|hybrid|wi-fi|eco)(?![а-яa-z])",
          "(?<![а-яa-z])(vm\\s*\\d+|d\\d+|es-vm|mp-\\d+|v\\d+|h\\d+)(?![а-яa-z])",
          "(?<![а-яa-z])(ntr|okc|okcv|okce|tpk|ntrr|bp|hp|dt\\d+v|pd|gch|gcv|bilight|bimode|b12|tsrs?)(?![а-яa-z0-9])"
        ]
      },
      {
        "_note": "Тип ТЕН — мокрий/сухий/керамічний",
        "when": "водонагрів|бойлер",
        "drop": [
          "(?<![а-яa-z])(мокр|сухий|сухим|ceramic|сух\\.?)(?![а-яa-z])\\.?\\s*тен"
        ]
      }
    ],
    "family": [
      {
        "match": "проточн",
        "label": "водонагрівач проточний"
      },
      {
        "match": "бойлер|накопичув|водонагрів",
        "label": "бойлер накопичувальний"
      }
    ]
  },
  "towel_warmers": {
    "rules": [
      {
        "_note": "Серії рушникосушок — маркетингові назви виробника",
        "drop": [
          "(?<![а-яa-z])(авангард|symmetry|fito|tristar|aquatristar|aqua|hygge|hotel|lotos|ellipse|avalon|marlin|luxury|lx-\\d+|escada|genesis|наvin|mario|laris|arte|deffi|bukovyna|polywarm|bureviy)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Тип підключення — несуттєво для ключа",
        "drop": [
          "(?<![а-яa-z])(прихован|бічн|бокове|нижн|центр)\\.?\\s*підключ[а-я]*"
        ]
      }
    ],
    "family": [
      {
        "match": "електричн",
        "label": "рушникосушка електрична"
      },
      {
        "match": "рушникосуш|полотенцесуш",
        "label": "рушникосушка водяна"
      }
    ]
  },
  "safety_valves": {
    "family": [
      {
        "match": "запобіжн|безпек|скидн",
        "label": "клапан запобіжний"
      }
    ]
  },
  "water_meters": {
    "family": [
      {
        "match": "лічильн|водомір",
        "label": "лічильник води"
      }
    ]
  },
  "automation": {
    "rules": [
      {
        "_note": "Артикули на початку назви (18427, 7R5R4, i-1m)",
        "drop": [
          "^\\d{4,}\\s+",
          "^[a-z0-9]{3,6}\\s+(?=[А-ЯA-Z])"
        ]
      }
    ],
    "family": [
      {
        "match": "насосн.?груп",
        "label": "насосна група"
      },
      {
        "match": "змішувальн",
        "label": "змішувальний вузол"
      },
      {
        "match": "стрілк",
        "label": "гідрострілка"
      },
      {
        "match": "регул",
        "label": "регулятор"
      }
    ]
  },
  "mixers_faucets": {
    "rules": [
      {
        "_note": "Артикули змішувачів і серії — кожен виробник унікальний артикул, не характеристика",
        "drop": [
          "(?<![а-яa-z0-9])(bla|crm|nks|wcr|watt)\\s*\\d[\\w\\-]*",
          "(?<![а-яa-z])(lx-\\d+|hs\\d+|bhs\\d+|bro\\d+|klo\\d+|leb\\d+)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Тип картриджу — не потрібен в ключі",
        "drop": [
          "кер/?карт\\s*ф?\\d+"
        ]
      }
    ],
    "family": [
      {
        "match": "умивальник|раковин",
        "label": "змішувач для умивальника"
      },
      {
        "match": "мийк|кухн",
        "label": "змішувач для кухні"
      },
      {
        "match": "ванн|душ",
        "label": "змішувач для ванни"
      }
    ]
  },
  "sanitary_ware": {
    "rules": [
      {
        "_note": "Назви серій ванн — не характеристика, а маркетингова назва. Прибираємо щоб ванна однакового розміру/типу різних серій мала один ключ.",
        "when": "ванн",
        "drop": [
          "(?<![а-яa-z])(albenia|albert|anastasia|anna|ariane|avita|bali|bonita|chrome|classic|comfort|dolores|edward|estella|favorit|florida|formy|freedom|greenland|harmony|infiniti|koller|lady|maddalena|madonna|maria|marina|mateo|melbourne|melite|molly|neon|newton|praktika|providence|quadro|rima|roca|saniform|santorini|shea|siena|surfex|tasmania|vanda|crea|intro|virgo|cetus|sela|kolo|ravak|aquaform|besco|miraggio|mirasoft|venta|smavit|eurowa)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Тип зливу — не характеристика ванни, а комплектація",
        "when": "ванн",
        "drop": [
          "\\+?\\s*(слив|злив|сифон|перелив)\\s*(глянець|матов|mirasoft|matte)?",
          "без\\s+(перелива|переливу|сифон)"
        ]
      },
      {
        "_note": "Колір ванни якщо не вказано спеціально — зазвичай біла",
        "when": "ванн",
        "drop": [
          "(?<![а-яa-z])(белая|біла|white)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Покриття — mirasoft/matt/глянець — різниця в ціні але не в типі товару для підбору аналогу",
        "when": "ванн",
        "drop": [
          "(?<![а-яa-z])(mirasoft|matt|матов|глянець|глянцев|matte)(?![а-яa-z])"
        ]
      },
      {
        "_note": "Унітаз: назви серій",
        "when": "унітаз",
        "drop": [
          "(?<![а-яa-z])(cersanit|roca|kolo|ravak|geberit|duravit|ideal\\s*standard|villeroy|grohe|hansgrohe)(?![а-яa-z])"
        ]
      }
    ],
    "family": [
      {
        "match": "унітаз",
        "label": "унітаз"
      },
      {
        "match": "інсталяц|інстал",
        "label": "інсталяція"
      },
      {
        "match": "раковин|умивальник",
        "label": "умивальник"
      },
      {
        "match": "ванн",
        "label": "ванна"
      },
      {
        "match": "піддон|кабін",
        "label": "душова"
      }
    ]
  }
}
